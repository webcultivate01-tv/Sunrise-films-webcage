# ---------------------------------------------------------------------------
# Sunrise Films - environment configuration
# Copy this file to `.env` and adjust the values for your machine.
# ---------------------------------------------------------------------------

APP_NAME="Sunrise Films"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# 32+ random characters. Used to sign/hash authentication tokens.
APP_KEY=a47cecd6cb89d592d2bc6aa5e46b2d3515c51c8d77697fb2

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u142338315_sunrise_vita
DB_USERNAME=u142338315_sunrise
DB_PASSWORD="TejasMehar@26"
DB_CHARSET=utf8mb4

# Authentication token lifetime, in minutes (default: 8 hours).
AUTH_TOKEN_LIFETIME=480
# Password reset link lifetime, in minutes.
RESET_TOKEN_LIFETIME=60
# Minimum password length enforced everywhere.
PASSWORD_MIN_LENGTH=8
# Failed logins allowed per email+IP before a temporary lockout.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Section 7 of the spec: the Forgot Password flow is available to Admin only
# when administrative policy enables it.
ADMIN_FORGOT_PASSWORD_ENABLED=false

# Mail. driver=log writes the message to storage/mail (useful before SMTP exists),
# driver=mail uses PHP's built-in mail().
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@sunrisefilms.local
MAIL_FROM_NAME="Sunrise Films"
